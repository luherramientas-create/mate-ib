rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStudent() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isTeacher() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Student roster: students need to read active student records so they can
    // select themselves in mate-ib. No client may modify the roster.
    match /instituciones/liceoCariari/cursosLectivos/2026/modalidades/bachilleratoInternacional/niveles/11/secciones/{section}/estudiantes/{studentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Assessment data: anonymous students can submit/save; non-anonymous
    // teacher accounts can read. No client can delete results.
    match /evaluaciones/2026/funcionesExponenciales/estudiantes/{studentId}/{document=**} {
      allow read: if isTeacher();
      allow create, update: if isStudent();
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
